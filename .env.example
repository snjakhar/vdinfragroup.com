# Copy to .env.local for development. In production set these in Cloudflare Pages.

# Public site URL (canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.vdinfragroup.com
# Where R2 images are served from (custom domain on the R2 bucket, same Cloudflare zone)
NEXT_PUBLIC_MEDIA_BASE_URL=https://media.vdinfragroup.com
# Google Analytics 4 measurement ID (leave empty to disable)
NEXT_PUBLIC_GA_ID=
# Cloudflare Turnstile site key (leave empty to disable the widget)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Enquiry endpoint (the Cloudflare Pages Function)
NEXT_PUBLIC_ENQUIRY_ENDPOINT=/api/enquiry

# Only for `npm run media:sync` (never exposed to the browser)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=vdinfragroup-media
